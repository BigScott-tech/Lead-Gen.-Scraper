# Telegram bot token for remote control
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: comma-separated Telegram numeric user IDs allowed to run jobs.
# Leave blank to allow anyone who can message the bot, unless TELEGRAM_ADMIN_TOKEN is set.
TELEGRAM_ADMIN_IDS=

# Optional: shared admin passphrase for /auth <token>.
TELEGRAM_ADMIN_TOKEN=

# Optional: specify an environment for the bot
ENV=production
